    "branch-protection:check:json": "powershell -ExecutionPolicy Bypass -File ./scripts/check-branch-protection.ps1 -Owner thomasbontrager -Repo shipforge-workflows -Branch main -Json"
  },
  "dependencies": {
    "@prisma/client": "7.5.0",
    "bcryptjs": "3.0.3",
    "next": "16.2.0",
    "next-auth": "4.24.13",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "prisma": "6.19.2",
    "typescript": "5.9.3"
  }
