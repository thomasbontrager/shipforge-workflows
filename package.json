{
  "name": "shipforge-workflows",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "env:check": "node scripts/check-required-env.mjs",
    "prisma:generate": "prisma generate",
    "db:safety-check": "node scripts/predeploy-db-safety.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "verify:all": "node scripts/verify-all.mjs",
    "branch-protection:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-branch-protection.ps1 -Owner thomasbontrager -Repo shipforge-workflows -Branch main",
